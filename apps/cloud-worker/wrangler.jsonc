{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dunyasalon",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dunyasalon-db",
      "database_id": "b308b606-bd9a-4f00-bd0f-395607396645",
      "migrations_dir": "../../migrations/cloud"
    }
  ],
  "routes": [{ "pattern": "panel.truvapark.com.tr", "custom_domain": true }],
  "observability": { "enabled": true }
  // Gizli anahtarlar (wrangler secret put ile):
  //   SYNC_TOKEN  – salon mini PC'sinin senkronizasyon anahtarı
  //   ADMIN_TOKEN – uzaktan yönetim paneli anahtarı
}
