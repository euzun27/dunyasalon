{
  "name": "@dunyatek/cloud-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build -w @dunyatek/web && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dunyasalon-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dunyasalon-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dunyatek/business-rules": "0.1.0",
    "@dunyatek/shared": "0.1.0",
    "@dunyatek/sync-protocol": "0.1.0",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "wrangler": "^4.40.0"
  }
}
