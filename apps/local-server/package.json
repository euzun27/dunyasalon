{
  "name": "@dunyatek/local-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "build": "esbuild src/index.ts src/seed.ts src/backup.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --out-extension:.js=.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "seed": "tsx src/seed.ts",
    "backup": "tsx src/backup.ts"
  },
  "dependencies": {
    "@dunyatek/business-rules": "0.1.0",
    "@dunyatek/shared": "0.1.0",
    "@dunyatek/sync-protocol": "0.1.0",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
